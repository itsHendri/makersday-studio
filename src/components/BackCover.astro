---
import { CREDITS } from "~/content/clippings"

/* The first four photographers, as on the Figma back cover (Q29). The full
 * list stays in clippings.ts, with every source. */

/*
 * The back cover (Q21) — what is waiting under the last sheet.
 *
 * paper.design ends with a footer that sits still while the page above it
 * lifts away. This is that, inside the rules of this rig: nothing may come
 * after the scroll track (upstream #36), so the back cover lives INSIDE the
 * stage, under the pile, printed on the desk. The last sheet slides off it
 * like every other sheet.
 *
 * It took the colophon from the cover and the credits from p. 14: the back
 * of a zine is where those are printed. "Back to the top" is gone — Hendri
 * removed it in Figma (Q27); the index and the scroll bar do that job.
 *
 * On the vertical read there is no pile, so it follows the last sheet in
 * flow and does paper.design's trick exactly: the cover's own box clips
 * (`clip-path: inset(0)`) and everything in it is `position: fixed` to the
 * bottom of the screen, so the sheets scroll up and off it and it never
 * moves. Nothing observes it, so the clip-path cannot blind an
 * IntersectionObserver (Q6).
 */
---

<section class="back-cover" id="tc-back" aria-label="Back cover" data-shown="false">
    <div class="back-inner">
        <div class="back-desk" aria-hidden="true"></div>

        <div class="back-cols">
            <div class="back-col">
                <p class="back-label t-label">Quarta Collective</p>
                <p class="t-body">
                    A space to make and create with friends. Quarta-feira:
                    Wednesday evenings, one table, a few of us.
                </p>
            </div>
            <div class="back-col">
                <p class="back-label t-label">Colophon</p>
                <p class="t-body">
                    This site tells the story; the notebook itself is made by
                    hand. Type: Amatic SC · Inter · Courier Prime · Special Elite.
                    hendri.design · 2026.
                </p>
            </div>
            <div class="back-col">
                <p class="back-label t-label">Photographs</p>
                <p class="t-body">
                    Placeholders, from Unsplash: {CREDITS.slice(0, 4).map((c) => `@${c}`).join(" · ")}.
                </p>
            </div>
        </div>

        {/* Pressed into the desk, the way paper.design sets its name into
            its footer: ink at a whisper, multiplied, with a light edge. */}
        <p class="back-wordmark" aria-hidden="true">Quarta</p>
    </div>
</section>

<script>
    /*
     * On the desk the back cover is covered by the pile until the last sheet
     * starts to go; until then it is hidden outright, so its wordmark never
     * peeks round the sheet's margins and its button cannot take focus.
     */
    const back = document.getElementById("tc-back")
    if (back) {
        window.addEventListener("tc:scroll", (e) => {
            const shown = window.innerWidth <= 810 || (e.detail?.end ?? 0) > 0
            const next = String(shown)
            if (back.dataset.shown !== next) back.dataset.shown = next
        })
    }
</script>

<style>
    .back-cover {
        position: absolute;
        inset: 0;
        z-index: 1; /* on the desk, under the pile (2) */
        pointer-events: none;
    }
    .back-cover[data-shown="false"] {
        visibility: hidden;
    }
    .back-inner {
        position: absolute;
        inset: 0;
        overflow: hidden;
    }
    /* The stage is already the desk; only the vertical read needs its own. */
    .back-desk {
        display: none;
    }

    .back-cols {
        position: absolute;
        left: 50%;
        top: calc(50% - var(--sheet-h) * var(--sheet-s, 1) / 2);
        width: calc(var(--sheet-w) * var(--sheet-s, 1));
        transform: translateX(-50%);
        box-sizing: border-box;
        padding: 72px 72px 0 76px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 56px;
        pointer-events: auto;
    }
    .back-col {
        max-width: 340px;
    }
    .back-col .t-body {
        color: var(--tc-fg);
        line-height: 1.7;
    }
    .back-label {
        margin-bottom: 14px;
        color: var(--tc-fg-dim);
    }


    .back-wordmark {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.2em;
        text-align: center;
        font-family: var(--font-title);
        font-size: min(30vw, 62vh);
        line-height: 1;
        letter-spacing: -0.02em;
        font-weight: 700;
        white-space: nowrap;
        /* text/emboss: the ink's alpha is in the token (8%), per theme. */
        color: var(--emboss);
        /* Pressed in: an edge below the stroke, as embossing catches the light. */
        text-shadow: 0 2px 0 var(--emboss-edge);
        pointer-events: none;
        user-select: none;
    }

    /*
     * The vertical read: paper.design's footer, as they built it. The cover's
     * box is a window (clip-path) onto layers fixed to the screen, so the last
     * sheet scrolls up off a back cover that does not move.
     */
    @media (max-width: 810px) {
        .back-cover {
            position: relative;
            inset: auto;
            order: 2;
            height: 100svh;
            clip-path: inset(0);
            pointer-events: auto;
        }
        .back-inner {
            position: fixed;
            inset: 0;
            overflow: hidden;
        }
        .back-desk {
            display: block;
            position: absolute;
            inset: 0;
            background-color: var(--desk);
            background-image:
                linear-gradient(to right, var(--desk-line) 1px, transparent 1px),
                linear-gradient(to bottom, var(--desk-line) 1px, transparent 1px);
            background-size: 10px 10px;
        }
        .back-cols {
            left: 0;
            top: 0;
            width: 100%;
            transform: none;
            padding: 72px 20px 0;
            grid-template-columns: 1fr;
            gap: 28px;
        }
    }
</style>
