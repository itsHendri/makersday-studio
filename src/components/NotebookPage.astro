---
/*
 * A page that is the visitor's: one kind to WRITE on (ruled), one kind to
 * DRAW on (dot grid). No mode switch — the page is one or the other, so
 * nobody has to choose before they start. Both keep what was put on them in
 * this browser's localStorage (`lib/notebook.ts`), and say so.
 *
 * Each has a headline at the size of every spread's (Q32): with only a
 * prompt it was not obvious the page was there to be used.
 */

interface Props {
    /** Index in the pile; the page number is n + 1. */
    n: number
    kind: "write" | "draw"
    /** [plain, emphasised], as on every spread. */
    title: [string, string]
    prompt: string
    /** Stable storage key — survives renumbering. */
    key: string
}

const { n, kind, title, prompt, key } = Astro.props
const [plain, lean] = title
const nn = String(n).padStart(2, "0")
---

<section
    class={`tc-sector notebook-spread ${kind === "write" ? "is-ruled is-write" : "is-grid is-draw"}`}
    id={`tc-sector-${nn}`}
    aria-label={`Page ${n + 1}: your page, ${kind}`}
>

    <h2 class="spread-title t-display" data-reveal>{plain && `${plain} `}<em>{lean}</em></h2>

    <p class="notebook-prompt t-body">{prompt}</p>

    <div class="notebook" data-notebook={key} data-nb-kind={kind}>
        {
            kind === "write" ? (
                <div
                    class="notebook-text t-body"
                    data-nb-text
                    contenteditable="plaintext-only"
                    role="textbox"
                    aria-multiline="true"
                    aria-label="Your notes"
                    data-placeholder="write here…"
                    spellcheck="false"
                />
            ) : (
                <>
                    <span class="notebook-cue t-body">draw here…</span>
                    <canvas class="notebook-ink" data-nb-ink aria-label="Your sketch" />
                </>
            )
        }
    </div>

    <div class="notebook-tools" data-nb-tools>
        <p class="notebook-kept t-eyebrow">kept on this device</p>
        <button type="button" class="t-label" data-nb-clear>clear</button>
    </div>
</section>
