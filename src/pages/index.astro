---
import Pile from "~/components/Pile.astro"
import Spread00 from "~/spreads/Spread00.astro"
import Spread01 from "~/spreads/Spread01.astro"
import Spread03 from "~/spreads/Spread03.astro"
import Spread05 from "~/spreads/Spread05.astro"
import Spread06 from "~/spreads/Spread06.astro"
import Spread07 from "~/spreads/Spread07.astro"
import Spread08 from "~/spreads/Spread08.astro"
import Spread09 from "~/spreads/Spread09.astro"
import NotebookPage from "~/components/NotebookPage.astro"
import { STORY } from "~/content/story"

/*
 * Maker's Day Studio (Q32): ten sheets on a desk telling how a thing gets
 * made — notice, start, use anything, make it anywhere, prototype, do it
 * again, then make it with us. Two of the ten are the visitor's own: one to
 * write on, one to draw on. Scrolling takes the sheets off one by one, to
 * the left, down to the back cover (Q19, Q21). The words are in
 * content/story.ts.
 *
 * RULINGS NEVER TOUCH (Q14): every ruled, dotted or squared sheet has a
 * plain one on both sides — plain, plain, ruled, plain, dots, plain,
 * squared, plain, ruled, plain.
 *
 * The desk, index, back cover and scripts are in components/Pile.astro.
 */
---

<Pile>
    <Spread00 />
    <Spread01 />
    <NotebookPage n={2} kind="write" key={STORY[2]!.notebook!.key} title={STORY[2]!.title} prompt={STORY[2]!.notebook!.prompt} />
    <Spread03 />
    <NotebookPage n={4} kind="draw" key={STORY[4]!.notebook!.key} title={STORY[4]!.title} prompt={STORY[4]!.notebook!.prompt} />
    <Spread05 />
    <Spread06 />
    <Spread07 />
    <Spread08 />
    <Spread09 />
</Pile>
