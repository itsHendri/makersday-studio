---
import Base from "~/layouts/Base.astro"

/*
 * Type specimen — the permanent dev surface for the type system. Every
 * preset on the two surfaces the theme prints on (the desk and a sheet), in
 * whichever theme the system is set to — switch the OS to dark to see the
 * cardboard-on-the-mat side (Q27). Not linked from the piece.
 */
const surfaces = [
    { name: "sheet", style: "--tc-bg: var(--sheet); --tc-field: var(--sheet);" },
    { name: "desk", style: "--tc-bg: var(--desk); --tc-field: var(--desk);" },
]
---

<Base title="Quarta Collective — specimen" description="Type specimen.">
    {
        surfaces.map((s) => (
            <section class="stop" style={s.style}>
                <p class="t-eyebrow">surface: {s.name}</p>
                <h2 class="t-display">
                    The art of <em>making</em>
                </h2>
                <p class="t-body">
                    Same table, same night. Phones in a bowl by the door.
                    Whoever arrives first puts the kettle on.
                </p>
                <p class="t-label">Index · p. 04</p>
                <p class="t-value">2026-10-05 · 48 pp · 160 gsm</p>
                <p>
                    <span class="t-inverted t-label">parked</span>
                </p>
            </section>
        ))
    }
</Base>

<style>
    .stop {
        background: var(--tc-bg);
        padding: 56px 72px;
        display: grid;
        gap: 18px;
    }
    .t-display {
        text-wrap: balance;
    }
</style>
