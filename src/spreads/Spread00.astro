---
import Clipping from "~/components/Clipping.astro"
import { STORY } from "~/content/story"

/* Spread 00 — The cover. The words are in content/story.ts (Q32). */
const page = STORY[0]!
const [plain, lean] = page.title
---

<section class="tc-sector" id="tc-sector-00" aria-label={`Cover: ${page.tab}`}>
    <h1 class="spread-title t-display" data-reveal>{plain && `${plain} `}<em>{lean}</em></h1>

    <p class="spread-note t-body">{page.body}</p>

    <Clipping
        id="00-0"
        src={page.photos[0].src}
        caption={page.photos[0].caption}
        x={900}
        y={120}
        w={360}
        h={470}
        kind="scan"
        rotate={3}
        tape
        eager
    />
</section>
