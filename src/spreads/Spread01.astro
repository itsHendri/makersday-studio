---
import Clipping from "~/components/Clipping.astro"

/* Spread 01 — the rule. */
---

<section class="tc-sector is-ruled" id="tc-sector-01" aria-label="Page 1: One evening a week">

    <h2 class="spread-title t-display" data-reveal>One evening a <em>week</em></h2>

    <p class="spread-note t-body">
        Same table, same night. Phones in a bowl by the door. Whoever arrives
        first puts the kettle on; whoever arrives last does the dishes. Nobody
        has to bring anything finished — just something started.
    </p>

    <Clipping
        id="01-0"
        src="artclass"
        caption="wk 1 — nobody knew what to make yet"
        x={760}
        y={330}
        w={430}
        h={290}
        kind="scan"
        tape
        eager
    />

    <Clipping
        id="01-1"
        src="table"
        caption="the table, before"
        x={150}
        y={490}
        w={320}
        h={210}
        kind="scan"
        rotate={-2}
        eager
    />
</section>
