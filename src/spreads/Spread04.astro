---
import Clipping from "~/components/Clipping.astro"

/* Spread 04 — sketches. The warm-white stretch of the stock. */
---

<section class="tc-sector" id="tc-sector-04" aria-label="Page 4: Bad drawings first">

    <h2 class="spread-title t-display" data-reveal>Bad drawings <em>first</em></h2>

    <p class="spread-note t-body">
        The first twenty sketches are for getting the bad ones out. Nobody is
        allowed to erase. The point is the pile, not the page.
    </p>

    <Clipping
        id="04-0"
        src="pillows"
        caption="twenty of these. then one more."
        x={90}
        y={480}
        w={430}
        h={270}
        kind="scan"
    />

    <Clipping
        id="04-1"
        src="portrait"
        caption="no. 14"
        x={580}
        y={440}
        w={210}
        h={270}
        kind="scan"
        rotate={3}
    />

    <Clipping
        id="04-2"
        src="desk"
        caption="J., not erasing"
        x={880}
        y={330}
        w={380}
        h={250}
        kind="scan"
        rotate={-2}
    />
</section>
