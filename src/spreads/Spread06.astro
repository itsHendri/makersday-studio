---
import Clipping from "~/components/Clipping.astro"

/* Spread 06 — the argument. */
---

<section class="tc-sector" id="tc-sector-06" aria-label="Page 6: What are we actually making?">

    <h2 class="spread-title t-display" data-reveal>What are we actually <em>making?</em></h2>

    <p class="spread-note t-body">
        The argument lasted most of an evening. A lamp. A chair. An app,
        briefly. Then someone said: the thing we keep reaching for is a
        notebook. So make one — half printed, half blank.
    </p>

    <Clipping
        id="06-0"
        src="mug"
        caption="the evening in question"
        x={820}
        y={340}
        w={440}
        h={290}
        kind="scan"
        tape
    />
</section>
