---
import Clipping from "~/components/Clipping.astro"
import { STORY } from "~/content/story"

/* Spread 08 — Again, better. Ruled stock: plain pages on both sides (Q14). The words are in content/story.ts (Q32). */
const page = STORY[8]!
const [plain, lean] = page.title
---

<section class="tc-sector is-ruled" id="tc-sector-08" aria-label={`Page 9: ${page.tab}`}>
    <h2 class="spread-title t-display" data-reveal>{plain && `${plain} `}<em>{lean}</em></h2>

    <p class="spread-note t-body">{page.body}</p>

    <Clipping
        id="08-0"
        src={page.photos[0].src}
        caption={page.photos[0].caption}
        x={820}
        y={130}
        w={380}
        h={260}
        kind="scan"
        rotate={-2}
        tape
    />

    <Clipping
        id="08-1"
        src={page.photos[1].src}
        caption={page.photos[1].caption}
        x={120}
        y={480}
        w={320}
        h={230}
        kind="scan"
        rotate={2}
    />

    <Clipping
        id="08-2"
        src={page.photos[2].src}
        caption={page.photos[2].caption}
        x={560}
        y={470}
        w={340}
        h={240}
        kind="scan"
        rotate={-1}
    />
</section>
