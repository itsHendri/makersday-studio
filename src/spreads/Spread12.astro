---
import Clipping from "~/components/Clipping.astro"
import Note from "~/components/Note.astro"

/* Spread 12 — the made thing. The yellow sheet turning back to white. */
---

<section class="tc-sector" id="tc-sector-12" aria-label="Page 12: The thing itself">

    <h2 class="spread-title t-display" data-reveal>The thing <em>itself</em></h2>

    <p class="spread-note t-body">
        Sixteen pages, 160gsm, folded and stapled, two inks. Eight printed,
        eight ruled and empty. Opens flat. The first blank page is blank on
        purpose.
    </p>


    <Clipping
        id="12-0"
        src="blank"
        caption="p. 1 — leave it"
        x={100}
        y={480}
        w={540}
        h={300}
        kind="scan"
    />

    <Clipping
        id="12-1"
        src="openpage"
        caption="p. 2 — yours"
        x={760}
        y={370}
        w={420}
        h={270}
        kind="scan"
        rotate={2}
    />

    <Note x={700} y={400} rotate={-4} size="sm" arrow="down">here</Note>
</section>
